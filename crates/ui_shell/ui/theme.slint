// ─── Data Structures ───

export struct ParticipantData {
    id: string,
    name: string,
    initial: string,
    is-muted: bool,
    is-deafened: bool,
    is-speaking: bool,
    volume: float,
    color-index: int,
    is-priority-speaker: bool,
    audio-level: int,
    // EQ: 0.0 = -6dB, 0.5 = flat, 1.0 = +6dB
    eq-bass: float,
    eq-mid: float,
    eq-treble: float,
    // Pan: 0.0 = full left, 0.5 = center, 1.0 = full right
    pan: float,
}

export struct PerfData {
    cpu-percent: float,
    memory-mb: float,
    peak-memory-mb: float,
    uptime-secs: int,
    audio-active: bool,
    network-connected: bool,
    dropped-frames: int,
    jitter-buffer-ms: int,
    frame-loss-percent: float,
    encode-bitrate-kbps: int,
    decode-peers: int,
    udp-active: bool,
    ping-ms: int,
    screen-frames-completed: int,
    screen-frames-dropped: int,
    screen-frames-timed-out: int,
    // M8
    capture-callback-median-ms: float,
    playback-callback-median-ms: float,
    audio-glitch-count: int,
    // M9
    memory-growth-mb: float,
}

export struct SpaceData {
    id: string,
    name: string,
    initial: string,
    member-count: int,
    channel-count: int,
    color-index: int,
    has-unread: bool,
}

export struct ChatMessage {
    sender-name: string,
    sender-initial: string,
    sender-id: string,
    content: string,
    timestamp: string,
    is-self: bool,
    mentions-self: bool,
    reply-sender-name: string,
    reply-preview: string,
    is-pinned: bool,
    color-index: int,
    message-id: string,
    edited: bool,
    reactions: string,
    is-code-block: bool,
    forwarded-from: string,
    attachment-name: string,
    attachment-size: string,
    attachment-id: string,
    attachment-image: image,
    has-attachment-image: bool,
    channel-name: string,
    show-header: bool,
    date-separator: string,
    reply-count: int,
    link-url: string,
    link-domain: string,
    link-preview-title: string,
    link-preview-description: string,
    is-new-separator: bool,
}

export struct ChannelData {
    id: string,
    name: string,
    peer-count: int,
    is-voice: bool,
    is-active: bool,
    unread-count: int,
    topic: string,
    voice-quality: int,
    category: string,
    status: string,
    user-limit: int,
    slow-mode-secs: int,
    is-category-header: bool,
    category-collapsed: bool,
    mention-count: int,
    auto-delete-hours: int,
    is-favorite: bool,
    notification-setting: string, // "all" (default), "mentions", "none"
}

export struct MemberData {
    id: string,
    user-id: string,
    name: string,
    initial: string,
    role-label: string,
    role-tier: int,
    channel-name: string,
    status: string,
    is-online: bool,
    is-in-voice: bool,
    color-index: int,
    status-level: int,
    is-server-muted: bool,
    is-friend: bool,
    has-incoming-request: bool,
    has-outgoing-request: bool,
    is-self: bool,
    bio: string,
    nickname: string,
    user-note: string,
    // Role color index: 0=default, 1=red, 2=blue, 3=green, 4=gold, 5=purple, 6=orange, 7=pink, 8=cyan
    role-color-index: int,
    // Activity status (e.g. "Playing Valorant"), empty if none
    activity: string,
    // True when this user is in the current user's local blocked list
    is-blocked-by-me: bool,
}

export struct GroupDMThreadData {
    group-id: string,
    name: string,
    member-count: int,
    preview: string,
    unread-count: int,
}

export struct AuditEntryData {
    actor-name: string,
    action: string,
    target-name: string,
    detail: string,
    timestamp: string,
}

export struct ScheduledEventData {
    id: string,
    title: string,
    description: string,
    start-time: string,
    creator-name: string,
    interested-count: int,
    is-interested: bool,
}

export struct FriendData {
    user-id: string,
    name: string,
    initial: string,
    detail: string,
    status-label: string,
    is-online: bool,
    is-in-voice: bool,
    color-index: int,
    is-friend: bool,
    last-seen: string,
}

export struct FriendRequestData {
    user-id: string,
    name: string,
    initial: string,
    detail: string,
    color-index: int,
}

export struct DirectMessageThreadData {
    user-id: string,
    name: string,
    initial: string,
    preview: string,
    meta: string,
    unread-count: int,
    is-online: bool,
    is-in-voice: bool,
    color-index: int,
}

export struct ShareSourceData {
    label: string,
    detail: string,
    kind-label: string,
}

export struct SavedServerData {
    name: string,
    address: string,
    is-default: bool,
}

export struct SoundboardClipData {
    name: string,
    path: string,
    keybind: string,
}

export struct AutomodWordData {
    word: string,
    action: string,
}

export struct PublicSpaceData {
    id: string,
    name: string,
    description: string,
    invite-code: string,
    member-count: int,
    channel-count: int,
    online-count: int,
    initial: string,
    color-index: int,
}

export struct StartupPhaseData {
    name: string,
    ms: int,
}

// ─── Design Tokens — Voxlink ───
// Voice-first broadcast console aesthetic: calm, sharp, premium

export global VxTheme {
    in-out property <int> theme-preset: 0;
    in-out property <bool> dark-mode: true;
    out property <bool> is-party: theme-preset == 1;
    out property <bool> is-space: theme-preset == 2;
    out property <bool> is-retro: theme-preset == 3;
    out property <bool> is-amber: theme-preset == 4;
    out property <bool> is-noir: theme-preset == 5;
    out property <bool> is-arctic: theme-preset == 6;

    // ── Design language ──
    // One neutral graphite base shared by every preset; presets differ only in
    // accent hue. Depth comes from three tonal surface steps + 1px hairlines —
    // no gradients, no glows, no per-preset canvas tints.

    // Core surfaces (preset-independent)
    out property <color> bg-canvas:  dark-mode ? #0f1013 : #f3f3f5;
    out property <color> bg-app:     dark-mode ? #131418 : #f7f7f8;
    out property <color> bg-panel:   dark-mode ? #17181d : #ffffff;
    out property <color> bg-card:    dark-mode ? #1b1d23 : #ffffff;
    out property <color> bg-raised:  dark-mode ? #232530 : #eeeef2;
    out property <color> bg-input:   dark-mode ? #101116 : #fafafb;
    out property <color> bg-rail:    dark-mode ? #0b0c0f : #ebebee;
    out property <color> bg-overlay: dark-mode ? #08090bd8 : #ffffffe0;
    out property <color> bg-soft:    dark-mode ? #1a1c22 : #f1f1f4;
    out property <color> bg-stage:   dark-mode ? #141519 : #f5f5f7;

    // Borders (preset-independent)
    out property <color> border-subtle: dark-mode ? #262832 : #e2e3e8;
    out property <color> border-strong: dark-mode ? #363945 : #cdced6;
    out property <color> border-focus:  accent;

    // Text (preset-independent)
    out property <color> text-primary:   dark-mode ? #ecedf0 : #17181c;
    out property <color> text-secondary: dark-mode ? #a6a9b3 : #55575f;
    out property <color> text-muted:     dark-mode ? #71747f : #8f929c;
    out property <color> text-inverse:   dark-mode ? #0e0f12 : #ffffff;

    // Accent — the only per-preset dimension
    out property <color> accent:
        is-party ? (dark-mode ? #7dd257 : #4e9e2e) :
        is-space ? (dark-mode ? #6ea1ff : #3f6fd8) :
        is-retro ? (dark-mode ? #52d6a4 : #1f9c6c) :
        is-amber ? (dark-mode ? #f2ac52 : #c07c1e) :
        is-noir ? (dark-mode ? #9fb0d0 : #5f6f95) :
        is-arctic ? (dark-mode ? #5ecbe8 : #1b93b4) :
        dark-mode ? #8b76ff : #6544e0;
    out property <color> accent-hover:   dark-mode ? accent.brighter(0.12) : accent.darker(0.10);
    out property <color> accent-pressed: dark-mode ? accent.darker(0.14) : accent.darker(0.22);
    out property <color> accent-glow:    accent.transparentize(0.86);
    out property <color> accent-subtle:  accent.transparentize(0.92);
    out property <color> accent-border:  accent.transparentize(0.68);
    out property <color> accent-warm:    accent;

    // States
    out property <color> success:        #3ecf8e;
    out property <color> success-dim:    dark-mode ? #3ecf8e22 : #3ecf8e16;
    out property <color> danger:         #ef6a6a;
    out property <color> danger-hover:   #f28080;
    out property <color> danger-pressed: #d95555;
    out property <color> warning:        #eba13f;
    out property <color> warning-soft:   dark-mode ? #eba13f1e : #eba13f14;

    // Interactive / utility
    out property <color> card-hover-bg:     dark-mode ? #1f2128 : #fafafc;
    out property <color> card-hover-border: border-strong;
    out property <color> btn-hover-bg:      dark-mode ? #262834 : #e8e8ee;
    out property <color> surface-active:    accent.transparentize(0.84);
    out property <color> row-hover-bg:      dark-mode ? #ffffff08 : #00000006;
    out property <color> speaking-row-bg:   accent.transparentize(0.90);
    out property <color> speaking-glow:     accent.transparentize(0.88);
    out property <color> speaking-border:   accent.transparentize(0.45);
    out property <color> mute-badge-bg:     dark-mode ? #2e1c1f : #fdeeee;
    out property <color> deafen-badge-bg:   dark-mode ? #2c2418 : #fbf4e6;
    out property <color> connection-lost-bg:dark-mode ? #2e1c1f : #fdeeee;
    out property <color> mic-glow-green:    dark-mode ? #3ecf8e2c : #3ecf8e1e;
    out property <color> mic-glow-yellow:   dark-mode ? #eba13f2c : #eba13f1e;
    out property <color> mic-glow-red:      dark-mode ? #ef6a6a2c : #ef6a6a1e;
    out property <color> msg-self-bg:       dark-mode ? accent.transparentize(0.88) : accent.transparentize(0.92);
    out property <color> msg-other-bg:      dark-mode ? #1a1c22 : #f1f1f4;
    out property <color> tab-active-bg:     accent.transparentize(0.88);

    // ── Chat density ──
    in-out property <bool> compact-chat: false;

    // ── Responsive scaling ──
    // Kept at 1.0 — responsive layout is handled by desktop-layout / shell-compact flags,
    // not by shrinking every dimension. The `s` multiplier remains for future use.
    in-out property <float> ui-scale: 1.0;
    out property <float> s: 1.0;

    // ── Spacing scale (4px grid) ──
    out property <length> space-xs:  4px;
    out property <length> space-sm:  8px;
    out property <length> space-md:  12px;
    out property <length> space-lg:  16px;
    out property <length> space-xl:  20px;
    out property <length> space-2xl: 24px;

    // ── Shape ──
    // One radius scale for every preset — shape gimmicks multiplied jank.
    out property <length> radius-card:    12px;
    out property <length> radius-control: 8px;
    out property <length> radius-pill:    999px;
    out property <length> gutter:         16px * ui-scale;

    // ── Padding tokens ──
    out property <length> pad-card:         18px;   // standard VxCard body
    out property <length> pad-card-compact: 14px;   // dense card body
    out property <length> space-card-rows:  14px;   // vertical spacing between rows in a card

    // ── Typography scale ──
    out property <length> font-display: 22px;   // hero / page titles
    out property <length> font-title:   17px;   // view & dialog titles
    out property <length> font-heading: 14px;   // card / section headers
    out property <length> font-body:    13px;   // default body text
    out property <length> font-label:   12px;   // labels, controls
    out property <length> font-caption: 11px;   // meta, secondary
    out property <length> font-micro:    10px;  // tiny meta — use sparingly
    out property <int> weight-regular:  400;
    out property <int> weight-medium:   500;
    out property <int> weight-semibold: 600;
    out property <int> weight-bold:     700;

    // ── Motion ──
    // Cheap, GPU-light transitions only (color / opacity / small offsets).
    out property <duration> dur-fast: 90ms;
    out property <duration> dur-base: 150ms;
    out property <duration> dur-slow: 240ms;

    // ── Lean depth ──
    // Elevation is tonal + hairline only. These stay as tokens for legacy
    // consumers but are intentionally near-invisible.
    out property <color> edge-highlight: dark-mode ? #ffffff08 : #ffffff00;
    out property <color> edge-shadow:    transparent;

    // ── Legacy component styling tokens (now constant across presets) ──
    out property <length> btn-border-width: 1px;
    out property <length> card-accent-height: 0px;
    out property <color> card-border: border-subtle;
    out property <bool> btn-uppercase: false;
    out property <int> heading-weight: 600;
    out property <length> section-spacing: 0.8px;
    out property <float> avatar-roundness: 0.5;

    // Compatibility aliases for legacy components
    out property <color> bg-deep:                bg-canvas;
    out property <color> bg-surface:             bg-panel;
    out property <color> bg-elevated:            bg-raised;
    out property <color> sidebar-bg:             bg-rail;
    out property <color> sidebar-item-hover:     row-hover-bg;
    out property <color> sidebar-item-active:    tab-active-bg;
    out property <color> sidebar-divider:        border-subtle;
    out property <color> sidebar-user-bg:        bg-soft;
    out property <color> header-accent-left:     border-subtle;
    out property <color> header-accent-mid:      border-subtle;
    out property <color> header-accent-right:    border-subtle;
    out property <color> card-shadow:            transparent;
    out property <color> elevation-shadow:       transparent;

    // Avatar color palette — muted, sits well on graphite
    public pure function avatar-color(idx: int) -> color {
        if idx == 0 { return #8b76ff; }
        if idx == 1 { return #56b4e8; }
        if idx == 2 { return #4fc99b; }
        if idx == 3 { return #e8a04c; }
        if idx == 4 { return #e87d97; }
        if idx == 5 { return #6ecad6; }
        if idx == 6 { return #a58cff; }
        return #d0b05c;
    }

    // Role color palette: 0=default (text-primary), 1=red, 2=blue, 3=green,
    // 4=gold, 5=purple, 6=orange, 7=pink, 8=cyan
    public pure function role-color(idx: int) -> color {
        if idx == 1 { return #e06c6c; }
        if idx == 2 { return #5e97e8; }
        if idx == 3 { return #52c07a; }
        if idx == 4 { return #d9b34a; }
        if idx == 5 { return #a97fe8; }
        if idx == 6 { return #e0904f; }
        if idx == 7 { return #e07da8; }
        if idx == 8 { return #4fc2cc; }
        return #00000000; // transparent = use default
    }
}
