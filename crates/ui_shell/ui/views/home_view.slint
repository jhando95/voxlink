import { ScrollView } from "std-widgets.slint";
import { DirectMessageThreadData, FriendData, GroupDMThreadData, PublicSpaceData, SavedServerData, SpaceData, VxTheme } from "../theme.slint";
import { Divider, FieldLabel, SectionLabel, StatusDot, VxAvatar, VxButton, VxCard, VxGlyphTile, VxInput, VxLogo, VxStatBlock, VxStatusPill } from "../components.slint";

export component HomeView inherits Rectangle {
    in property <bool> wide: false;
    in-out property <string> server-address: "";
    in-out property <string> user-name: "";
    in property <string> status-text: "";
    in property <bool> is-connected: false;
    in property <bool> first-run: false;
    in property <[SpaceData]> spaces: [];
    in-out property <string> space-name: "";
    in-out property <string> space-invite-code: "";
    in-out property <bool> show-quick-call: false;
    in-out property <string> join-code: "";
    in-out property <string> room-password: "";
    in property <[DirectMessageThreadData]> direct-message-threads: [];
    in property <int> unread-direct-messages-count: 0;
    in property <[GroupDMThreadData]> group-dm-threads: [];
    in property <[FriendData]> favorite-friends: [];
    in property <[string]> new-group-dm-selection: [];
    in-out property <bool> show-new-group-dm-picker: false;
    callback toggle-new-group-dm-friend(string);
    callback create-group-dm();
    callback open-group-dm(string);
    in property <[SavedServerData]> saved-servers: [];
    in property <bool> streamer-mode: false;
    in-out property <string> activity-text: "";
    callback connect-server();
    callback disconnect-server();
    callback find-server();
    callback save-server(string);
    callback remove-server(int);
    callback select-space(string);
    callback create-space();
    callback join-space();
    callback create-room();
    callback join-room(string);
    callback open-direct-message(string);
    callback close-direct-message(string);
    callback call-user(string); // user_id — initiate DM voice call
    callback set-activity(string);
    callback dismiss-welcome();
    in property <[PublicSpaceData]> public-spaces: [];
    callback browse-public-spaces();
    callback join-public-space(string); // invite_code
    property <bool> show-explore: false;
    property <length> side-column-width: clamp(root.width * 0.24, 232px, 276px);

    background: transparent;

    ScrollView {
        vertical-stretch: 1;

        VerticalLayout {
            padding: (root.wide ? 16px : 12px) * VxTheme.s;
            spacing: 12px * VxTheme.s;

            VxCard {
                HorizontalLayout {
                    padding: root.wide ? 20px : 16px;
                    spacing: 14px;
                    alignment: center;

                    VxLogo { logo-size: root.wide ? 56px : 44px; }

                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        horizontal-stretch: 1;

                        Text {
                            text: root.user-name != "" && root.user-name != "User"
                                ? "Welcome back, " + root.user-name
                                : "Voice without the drag";
                            color: VxTheme.text-primary;
                            font-size: root.wide ? 22px : 19px;
                            font-weight: 600;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            VxStatusPill {
                                label: root.status-text;
                                tone: root.is-connected ? VxTheme.success :
                                      root.status-text == "Connecting..." ? VxTheme.warning : VxTheme.text-secondary;
                                fill: root.is-connected ? VxTheme.success-dim :
                                      root.status-text == "Connecting..." ? VxTheme.warning-soft : VxTheme.bg-soft;
                            }
                            if root.unread-direct-messages-count > 0 : VxStatusPill {
                                label: root.unread-direct-messages-count + " unread";
                            }
                        }
                    }
                }
            }

            // Activity status — let users set "Playing ...", "Working on ..."
            if root.is-connected : HorizontalLayout {
                spacing: 8px;
                alignment: stretch;
                VxInput {
                    horizontal-stretch: 1;
                    placeholder: "Set activity (e.g. Playing Valorant)";
                    text <=> root.activity-text;
                    accepted => {
                        root.set-activity(root.activity-text);
                    }
                }
                VxButton {
                    label: root.activity-text == "" ? "Set" : "Clear";
                    small: true;
                    soft: root.activity-text != "";
                    accent: root.activity-text == "";
                    clicked => {
                        if root.activity-text != "" {
                            root.activity-text = "";
                            root.set-activity("");
                        } else {
                            root.set-activity(root.activity-text);
                        }
                    }
                }
            }

            // First-run welcome card — shown once for new users, dismissed via "Got it!"
            if root.first-run : VxCard {
                VerticalLayout {
                    padding: 20px;
                    spacing: 16px;

                    Text {
                        text: "Welcome to Voxlink";
                        color: VxTheme.text-primary;
                        font-size: 20px;
                        font-weight: 700;
                    }

                    Text {
                        text: "Voxlink is a voice-first chat app. Here's how to get started:";
                        color: VxTheme.text-secondary;
                        font-size: 13px;
                        wrap: word-wrap;
                    }

                    // Step 1: Create a Space
                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            background: VxTheme.accent;
                            Text {
                                text: "1";
                                color: VxTheme.text-inverse;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "Create a Space";
                                color: VxTheme.text-primary;
                                font-size: 13px;
                                font-weight: 600;
                            }
                            Text {
                                text: "Your own server with voice and text channels.";
                                color: VxTheme.text-muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // Step 2: Invite Friends
                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            background: VxTheme.accent;
                            Text {
                                text: "2";
                                color: VxTheme.text-inverse;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "Invite Friends";
                                color: VxTheme.text-primary;
                                font-size: 13px;
                                font-weight: 600;
                            }
                            Text {
                                text: "Share your invite code to bring people in.";
                                color: VxTheme.text-muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // Step 3: Join a Voice Channel
                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            background: VxTheme.accent;
                            Text {
                                text: "3";
                                color: VxTheme.text-inverse;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "Join a Voice Channel";
                                color: VxTheme.text-primary;
                                font-size: 13px;
                                font-weight: 600;
                            }
                            Text {
                                text: "Click any voice channel to start talking.";
                                color: VxTheme.text-muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // Step 4: Chat
                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            background: VxTheme.accent;
                            Text {
                                text: "4";
                                color: VxTheme.text-inverse;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "Chat";
                                color: VxTheme.text-primary;
                                font-size: 13px;
                                font-weight: 600;
                            }
                            Text {
                                text: "Use text channels for messages, reactions, and threads.";
                                color: VxTheme.text-muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: end;
                        VxButton {
                            label: "Got it";
                            accent: true;
                            clicked => {
                                root.dismiss-welcome();
                            }
                        }
                    }
                }
            }

            if root.wide : HorizontalLayout {
                spacing: 12px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 12px;

                    VxCard {
                        VerticalLayout {
                            padding: 18px;
                            spacing: 14px;

                            SectionLabel { text: "SERVER"; }

                            VerticalLayout {
                                spacing: 6px;
                                FieldLabel { text: "Server address"; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    VxInput {
                                        prominent: true;
                                        text <=> root.server-address;
                                        placeholder: "wss://voice.example.com:443 or ws://127.0.0.1:9090";
                                        horizontal-stretch: 1;
                                        accepted => {
                                            if !root.is-connected {
                                                root.connect-server();
                                            }
                                        }
                                    }
                                    VxButton {
                                        label: "Save";
                                        soft: true;
                                        clicked => { root.save-server(root.server-address); }
                                    }
                                }
                            }

                            // Saved servers list
                            if root.saved-servers.length > 0 : VerticalLayout {
                                spacing: 4px;
                                FieldLabel { text: "Saved servers"; }
                                for server[idx] in root.saved-servers : Rectangle {
                                    height: 36px;
                                    border-radius: VxTheme.radius-control;
                                    background: server-touch.has-hover ? VxTheme.row-hover-bg : transparent;
                                    border-color: server.is-default ? VxTheme.accent-border :
                                                  server-touch.has-hover ? VxTheme.border-subtle : transparent;
                                    border-width: 1px;
                                    clip: true;

                                    server-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.server-address = server.address;
                                        }
                                    }

                                    Rectangle {
                                        x: 0px;
                                        y: 6px;
                                        width: 3px;
                                        height: parent.height - 12px;
                                        border-radius: 2px;
                                        background: server.is-default ? VxTheme.accent : transparent;
                                    }

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 6px;
                                        spacing: 8px;
                                        alignment: center;

                                        if server.is-default : Rectangle {
                                            width: 6px;
                                            height: 6px;
                                            border-radius: 3px;
                                            background: VxTheme.accent;
                                        }

                                        Text {
                                            text: server.name;
                                            color: VxTheme.text-primary;
                                            font-size: 12px;
                                            font-weight: 500;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: root.streamer-mode ? "ws://***:****" : server.address;
                                            color: VxTheme.text-muted;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }

                                        remove-touch := TouchArea {
                                            width: 20px;
                                            height: 20px;
                                            mouse-cursor: pointer;
                                            clicked => { root.remove-server(idx); }
                                            Text {
                                                text: "✕";
                                                color: remove-touch.has-hover ? VxTheme.danger : VxTheme.text-muted;
                                                font-size: 12px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                alignment: end;
                                if !root.is-connected : VxButton {
                                    label: "Find on LAN";
                                    ghost: true;
                                    clicked => { root.find-server(); }
                                }
                                if !root.is-connected : VxButton {
                                    label: root.status-text == "Connecting..." ? "Connecting..." : "Connect";
                                    accent: true;
                                    enabled: root.status-text != "Connecting...";
                                    min-width: 140px;
                                    clicked => { root.connect-server(); }
                                }
                                if root.is-connected : VxButton {
                                    label: "Disconnect";
                                    danger: true;
                                    min-width: 140px;
                                    clicked => { root.disconnect-server(); }
                                }
                            }

                            Divider {}

                            VerticalLayout {
                                spacing: 6px;
                                FieldLabel { text: "Display name"; }
                                VxInput {
                                    text <=> root.user-name;
                                    placeholder: "Enter a display name";
                                }
                            }
                        }
                    }

                    VxCard {
                        VerticalLayout {
                            padding: 18px;
                            spacing: 12px;

                            HorizontalLayout {
                                alignment: space-between;
                                SectionLabel { text: "SPACES"; }
                                if root.spaces.length > 0 : Text {
                                    text: root.spaces.length + " linked";
                                    color: VxTheme.text-muted;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                            }

                            if root.spaces.length == 0 : Rectangle {
                                border-radius: VxTheme.radius-card;
                                background: VxTheme.bg-soft;
                                border-color: VxTheme.border-subtle;
                                border-width: 1px;
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 5px;
                                    Text {
                                        text: "Your workspace rail is empty.";
                                        color: VxTheme.text-primary;
                                        font-size: 13px;
                                        font-weight: 700;
                                    }
                                    Text {
                                        text: "Create a space to get channels, members, and chat in one place.";
                                        color: VxTheme.text-muted;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            for space in root.spaces : Rectangle {
                                height: 54px;
                                border-radius: VxTheme.radius-control;
                                background: space-wide-touch.has-hover ? VxTheme.row-hover-bg : VxTheme.bg-soft;
                                border-color: space.has-unread ? VxTheme.accent-border :
                                              space-wide-touch.has-hover ? VxTheme.border-subtle : VxTheme.border-subtle;
                                border-width: 1px;
                                clip: true;

                                space-wide-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.select-space(space.id); }
                                }

                                Rectangle {
                                    x: 0px;
                                    y: 8px;
                                    width: 3px;
                                    height: parent.height - 16px;
                                    border-radius: 2px;
                                    background: space.has-unread ? VxTheme.accent : transparent;
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 12px;
                                    alignment: center;

                                    VxAvatar {
                                        avatar-size: 36px;
                                        initial: space.initial;
                                        color-index: space.color-index;
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text {
                                            text: space.name;
                                            color: VxTheme.text-primary;
                                            font-size: 13px;
                                            font-weight: 700;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: space.member-count + " members  ·  " + space.channel-count + " channels";
                                            color: VxTheme.text-muted;
                                            font-size: 11px;
                                            overflow: elide;
                                        }
                                    }

                                    if space.has-unread : VxStatusPill {
                                        label: "New";
                                        tone: VxTheme.accent;
                                        fill: VxTheme.accent-subtle;
                                    }
                                    VxStatusPill {
                                        label: "Open";
                                        tone: VxTheme.accent;
                                        fill: VxTheme.accent-subtle;
                                    }
                                }
                            }
                        }
                    }

                    VxCard {
                        VerticalLayout {
                            padding: 18px;
                            spacing: 12px;

                            HorizontalLayout {
                                alignment: space-between;
                                SectionLabel { text: "DIRECT MESSAGES"; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    if root.unread-direct-messages-count > 0 : VxStatusPill {
                                        label: root.unread-direct-messages-count + " unread";
                                        tone: VxTheme.accent;
                                        fill: VxTheme.accent-subtle;
                                    }
                                    VxButton {
                                        label: root.show-new-group-dm-picker ? "Cancel" : "New group";
                                        glyph: root.show-new-group-dm-picker ? "CN" : "GP";
                                        small: true;
                                        soft: true;
                                        clicked => {
                                            root.show-new-group-dm-picker = !root.show-new-group-dm-picker;
                                        }
                                    }
                                }
                            }

                            // Inline multi-select friend picker for creating a group DM
                            if root.show-new-group-dm-picker : Rectangle {
                                border-radius: VxTheme.radius-card;
                                background: VxTheme.bg-soft;
                                border-color: VxTheme.accent-border.transparentize(0.5);
                                border-width: 1px;
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 8px;
                                    Text {
                                        text: "Pick 2 or more friends for a group conversation.";
                                        color: VxTheme.text-secondary;
                                        font-size: 12px;
                                    }
                                    if root.favorite-friends.length == 0 : Text {
                                        text: "Add some friends first.";
                                        color: VxTheme.text-muted;
                                        font-size: 12px;
                                    }
                                    for friend in root.favorite-friends : Rectangle {
                                        height: 32px;
                                        border-radius: VxTheme.radius-control;
                                        background: gp-friend-touch.has-hover ? VxTheme.row-hover-bg : transparent;
                                        gp-friend-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.toggle-new-group-dm-friend(friend.user-id); }
                                        }
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 10px;
                                            alignment: center;
                                            Rectangle {
                                                width: 16px;
                                                height: 16px;
                                                border-radius: 4px;
                                                border-width: 1px;
                                                // Highlight check when the user-id is in the selection
                                                background: root.new-group-dm-selection.length > 0
                                                    && (
                                                        root.new-group-dm-selection[0] == friend.user-id
                                                        || (root.new-group-dm-selection.length > 1 && root.new-group-dm-selection[1] == friend.user-id)
                                                        || (root.new-group-dm-selection.length > 2 && root.new-group-dm-selection[2] == friend.user-id)
                                                        || (root.new-group-dm-selection.length > 3 && root.new-group-dm-selection[3] == friend.user-id)
                                                        || (root.new-group-dm-selection.length > 4 && root.new-group-dm-selection[4] == friend.user-id)
                                                        || (root.new-group-dm-selection.length > 5 && root.new-group-dm-selection[5] == friend.user-id)
                                                        || (root.new-group-dm-selection.length > 6 && root.new-group-dm-selection[6] == friend.user-id)
                                                        || (root.new-group-dm-selection.length > 7 && root.new-group-dm-selection[7] == friend.user-id)
                                                    )
                                                    ? VxTheme.accent : transparent;
                                                border-color: VxTheme.border-strong;
                                            }
                                            Text {
                                                text: friend.name;
                                                color: VxTheme.text-primary;
                                                font-size: 13px;
                                                font-weight: 600;
                                                horizontal-stretch: 1;
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: end;
                                        Text {
                                            text: root.new-group-dm-selection.length + " selected";
                                            color: VxTheme.text-muted;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        VxButton {
                                            label: "Create group";
                                            glyph: "OK";
                                            small: true;
                                            accent: true;
                                            enabled: root.new-group-dm-selection.length >= 2;
                                            clicked => {
                                                root.create-group-dm();
                                                root.show-new-group-dm-picker = false;
                                            }
                                        }
                                    }
                                }
                            }

                            // Group DM threads
                            for group in root.group-dm-threads : Rectangle {
                                border-radius: VxTheme.radius-control;
                                background: gp-thread-touch.has-hover ? VxTheme.row-hover-bg : VxTheme.bg-soft;
                                border-color: group.unread-count > 0 ? VxTheme.accent-border : VxTheme.border-subtle;
                                border-width: 1px;
                                gp-thread-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.open-group-dm(group.group-id); }
                                }
                                HorizontalLayout {
                                    padding: 10px;
                                    spacing: 10px;
                                    alignment: center;
                                    VxGlyphTile {
                                        tile-size: 28px;
                                        glyph: "GP";
                                        tone: VxTheme.accent;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text {
                                                text: group.name;
                                                color: VxTheme.text-primary;
                                                font-size: 12px;
                                                font-weight: 700;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: group.member-count + " people";
                                                color: VxTheme.text-muted;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text {
                                            text: group.preview;
                                            color: VxTheme.text-secondary;
                                            font-size: 12px;
                                            overflow: elide;
                                        }
                                    }
                                    if group.unread-count > 0 : VxStatusPill {
                                        label: group.unread-count + "";
                                        tone: VxTheme.accent;
                                        fill: VxTheme.accent-subtle;
                                    }
                                }
                            }

                            if root.direct-message-threads.length == 0 : Rectangle {
                                border-radius: VxTheme.radius-card;
                                background: VxTheme.bg-soft;
                                border-color: VxTheme.border-subtle;
                                border-width: 1px;
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 5px;
                                    Text {
                                        text: "No conversations yet";
                                        color: VxTheme.text-secondary;
                                        font-size: 13px;
                                        font-weight: 700;
                                    }
                                    Text {
                                        text: "Start a conversation from your friends list.";
                                        color: VxTheme.text-muted;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            for thread in root.direct-message-threads : Rectangle {
                                border-radius: VxTheme.radius-control;
                                background: dm-wide-touch.has-hover ? VxTheme.row-hover-bg : VxTheme.bg-soft;
                                border-color: thread.unread-count > 0 ? VxTheme.accent-border :
                                              thread.is-in-voice ? VxTheme.speaking-border :
                                              dm-wide-touch.has-hover ? VxTheme.border-subtle :
                                              thread.is-online ? VxTheme.border-strong : VxTheme.border-subtle;
                                border-width: 1px;
                                clip: true;

                                dm-wide-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.open-direct-message(thread.user-id); }
                                }

                                Rectangle {
                                    x: 0px;
                                    y: 8px;
                                    width: 3px;
                                    height: parent.height - 16px;
                                    border-radius: 2px;
                                    background: thread.unread-count > 0 ? VxTheme.accent :
                                        thread.is-in-voice ? VxTheme.speaking-border : transparent;
                                }

                                HorizontalLayout {
                                    padding: 12px;
                                    spacing: 10px;
                                    alignment: center;

                                    VxAvatar {
                                        avatar-size: 32px;
                                        initial: thread.initial;
                                        color-index: thread.color-index;
                                        show-status: true;
                                        is-online: thread.is-online;
                                        is-speaking: thread.is-in-voice;
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        spacing: 2px;

                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;
                                            Text {
                                                text: thread.name;
                                                color: VxTheme.text-primary;
                                                font-size: 12px;
                                                font-weight: 700;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: thread.meta;
                                                color: VxTheme.text-muted;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Text {
                                            text: thread.preview;
                                            color: VxTheme.text-secondary;
                                            font-size: 12px;
                                            overflow: elide;
                                        }
                                    }

                                    if thread.unread-count > 0 : VxStatusPill {
                                        label: thread.unread-count + "";
                                        tone: VxTheme.accent;
                                        fill: VxTheme.accent-subtle;
                                    }

                                    if dm-wide-touch.has-hover : Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border-radius: 4px;
                                        background: dm-call-wide.has-hover ? VxTheme.success.transparentize(0.8) : transparent;
                                        dm-call-wide := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.call-user(thread.user-id); }
                                        }
                                        Text {
                                            text: "Go";
                                            color: dm-call-wide.has-hover ? VxTheme.success : VxTheme.text-muted;
                                            font-size: 11px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    if dm-wide-touch.has-hover : Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border-radius: 4px;
                                        background: dm-close-wide.has-hover ? VxTheme.bg-elevated : transparent;
                                        dm-close-wide := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.close-direct-message(thread.user-id); }
                                        }
                                        Text {
                                            text: "\u{00D7}";
                                            color: dm-close-wide.has-hover ? VxTheme.text-primary : VxTheme.text-muted;
                                            font-size: 14px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    width: root.side-column-width;
                    spacing: 12px;

                    if root.join-code != "" : VxCard {
                        VerticalLayout {
                            padding: 18px;
                            spacing: 12px;
                            SectionLabel { text: "RECENT ROOM"; }
                            VxStatBlock {
                                label: "Last call code";
                                value: root.join-code;
                                detail: "Stored locally so you can jump back in faster.";
                                tone: VxTheme.accent;
                            }
                            VxButton {
                                label: root.is-connected ? "Rejoin last call" : "Connect to rejoin";
                                accent: root.is-connected;
                                enabled: root.is-connected;
                                horizontal-stretch: 1;
                                clicked => { root.join-room(root.join-code); }
                            }
                        }
                    }

                    VxCard {
                        VerticalLayout {
                            padding: 18px;
                            spacing: 12px;

                            SectionLabel { text: "SPACES"; }

                            VerticalLayout {
                                spacing: 6px;
                                FieldLabel { text: "Create a new space"; }
                                Text {
                                    text: "A space is your own group with voice and text channels.";
                                    color: VxTheme.text-muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                VxInput {
                                    prominent: true;
                                    text <=> root.space-name;
                                    placeholder: "Studio, Guild, Squad";
                                    accepted => {
                                        if root.is-connected && root.space-name != "" {
                                            root.create-space();
                                        }
                                    }
                                }
                            }

                            VxButton {
                                label: "Create Space";
                                accent: true;
                                enabled: root.is-connected && root.space-name != "";
                                horizontal-stretch: 1;
                                clicked => { root.create-space(); }
                            }

                            Divider {}

                            VerticalLayout {
                                spacing: 6px;
                                FieldLabel { text: "Join by invite"; }
                                VxInput {
                                    prominent: true;
                                    text <=> root.space-invite-code;
                                    placeholder: "Paste invite code";
                                    accepted => {
                                        if root.is-connected && root.space-invite-code != "" {
                                            root.join-space();
                                        }
                                    }
                                }
                            }

                            VxButton {
                                label: "Join Space";
                                soft: true;
                                enabled: root.is-connected && root.space-invite-code != "";
                                horizontal-stretch: 1;
                                clicked => { root.join-space(); }
                            }
                        }
                    }

                    VxCard {
                        VerticalLayout {
                            padding: 18px;
                            spacing: 12px;

                            HorizontalLayout {
                                alignment: space-between;
                                SectionLabel { text: "QUICK CALL"; }
                                VxButton {
                                    label: root.show-quick-call ? "Hide" : "Show";
                                    small: true;
                                    ghost: true;
                                    clicked => { root.show-quick-call = !root.show-quick-call; }
                                }
                            }

                            Text {
                                text: "Fast room codes for ad-hoc voice without building a full space.";
                                color: VxTheme.text-muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }

                            if root.show-quick-call : VerticalLayout {
                                spacing: 10px;

                                VxButton {
                                    label: root.status-text == "Starting call..." ? "Starting..." :
                                           root.is-connected ? "Start Call" : "Connect first";
                                    accent: true;
                                    enabled: root.is-connected && root.status-text != "Starting call..." && root.status-text != "Joining call...";
                                    horizontal-stretch: 1;
                                    clicked => { root.create-room(); }
                                }

                                VerticalLayout {
                                    spacing: 6px;
                                    FieldLabel { text: "Join by room code"; }
                                    VxInput {
                                        prominent: true;
                                        text <=> root.join-code;
                                        placeholder: "Room code";
                                        accepted => {
                                            if root.is-connected && root.join-code != "" {
                                                root.join-room(root.join-code);
                                            }
                                        }
                                    }
                                }

                                VerticalLayout {
                                    spacing: 8px;
                                    VxInput {
                                        prominent: true;
                                        text <=> root.room-password;
                                        placeholder: "Password (optional)";
                                        input-type: InputType.password;
                                        horizontal-stretch: 1;
                                    }
                                    VxButton {
                                        label: "Join";
                                        soft: true;
                                        horizontal-stretch: 1;
                                        enabled: root.is-connected && root.join-code != "";
                                        clicked => { root.join-room(root.join-code); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if !root.wide : VerticalLayout {
                spacing: 12px;

                VxCard {
                    VerticalLayout {
                        padding: 18px;
                        spacing: 14px;

                        SectionLabel { text: "SERVER"; }

                        VerticalLayout {
                            spacing: 6px;
                            FieldLabel { text: "Server address"; }
                            VerticalLayout {
                                spacing: 8px;
                                VxInput {
                                    prominent: true;
                                    text <=> root.server-address;
                                    placeholder: "wss://voice.example.com:443 or ws://127.0.0.1:9090";
                                    horizontal-stretch: 1;
                                    accepted => {
                                        if !root.is-connected {
                                            root.connect-server();
                                        }
                                    }
                                }
                                VxButton {
                                    label: "Save";
                                    soft: true;
                                    horizontal-stretch: 1;
                                    clicked => { root.save-server(root.server-address); }
                                }
                            }
                        }

                        // Saved servers list (narrow)
                        if root.saved-servers.length > 0 : VerticalLayout {
                            spacing: 4px;
                                FieldLabel { text: "Saved servers"; }
                                for server[idx] in root.saved-servers : Rectangle {
                                    height: 36px;
                                    border-radius: VxTheme.radius-control;
                                    background: narrow-server-touch.has-hover ? VxTheme.row-hover-bg : transparent;
                                    border-color: server.is-default ? VxTheme.accent-border :
                                                  narrow-server-touch.has-hover ? VxTheme.border-subtle : transparent;
                                    border-width: 1px;
                                    clip: true;

                                    narrow-server-touch := TouchArea {
                                        mouse-cursor: pointer;
                                    clicked => {
                                        root.server-address = server.address;
                                        }
                                    }

                                    Rectangle {
                                        x: 0px;
                                        y: 6px;
                                        width: 3px;
                                        height: parent.height - 12px;
                                        border-radius: 2px;
                                        background: server.is-default ? VxTheme.accent : transparent;
                                    }

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 6px;
                                    spacing: 8px;
                                    alignment: center;

                                    if server.is-default : Rectangle {
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: VxTheme.accent;
                                    }

                                    Text {
                                        text: server.name;
                                        color: VxTheme.text-primary;
                                        font-size: 12px;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: root.streamer-mode ? "ws://***:****" : server.address;
                                        color: VxTheme.text-muted;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }

                                    narrow-remove-touch := TouchArea {
                                        width: 20px;
                                        height: 20px;
                                        mouse-cursor: pointer;
                                        clicked => { root.remove-server(idx); }
                                        Text {
                                            text: "✕";
                                            color: narrow-remove-touch.has-hover ? VxTheme.danger : VxTheme.text-muted;
                                            font-size: 12px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            if !root.is-connected : VxButton {
                                label: root.status-text == "Connecting..." ? "Connecting..." : "Connect";
                                accent: true;
                                enabled: root.status-text != "Connecting...";
                                horizontal-stretch: 1;
                                clicked => { root.connect-server(); }
                            }
                            if root.is-connected : VxButton {
                                label: "Disconnect";
                                danger: true;
                                horizontal-stretch: 1;
                                clicked => { root.disconnect-server(); }
                            }
                            if !root.is-connected : VxButton {
                                label: "Find on LAN";
                                soft: true;
                                clicked => { root.find-server(); }
                            }
                        }

                        VerticalLayout {
                            spacing: 6px;
                            FieldLabel { text: "Display name"; }
                            VxInput {
                                prominent: true;
                                text <=> root.user-name;
                                placeholder: "Enter a display name";
                            }
                        }
                    }
                }

                VxCard {
                    VerticalLayout {
                        padding: 18px;
                        spacing: 12px;
                        SectionLabel { text: "SPACE BUILDER"; }

                        VerticalLayout {
                            spacing: 6px;
                            FieldLabel { text: "Create a new space"; }
                            VxInput {
                                prominent: true;
                                text <=> root.space-name;
                                placeholder: "Studio, Guild, Squad";
                                accepted => {
                                    if root.is-connected && root.space-name != "" {
                                        root.create-space();
                                    }
                                }
                            }
                        }

                        VxButton {
                            label: "Create Space";
                            accent: true;
                            enabled: root.is-connected && root.space-name != "";
                            horizontal-stretch: 1;
                            clicked => { root.create-space(); }
                        }

                        Divider {}

                        VerticalLayout {
                            spacing: 6px;
                            FieldLabel { text: "Join by invite"; }
                            VxInput {
                                prominent: true;
                                text <=> root.space-invite-code;
                                placeholder: "Paste invite code";
                                accepted => {
                                    if root.is-connected && root.space-invite-code != "" {
                                        root.join-space();
                                    }
                                }
                            }
                        }

                        VxButton {
                            label: "Join Space";
                            soft: true;
                            enabled: root.is-connected && root.space-invite-code != "";
                            horizontal-stretch: 1;
                            clicked => { root.join-space(); }
                        }
                    }
                }

                VxCard {
                    VerticalLayout {
                        padding: 18px;
                        spacing: 12px;
                        if root.join-code != "" : VxStatBlock {
                            label: "Recent room";
                            value: root.join-code;
                            detail: "Jump back in when you are ready.";
                            tone: VxTheme.accent;
                        }
                        if root.join-code != "" : VxButton {
                            label: root.is-connected ? "Rejoin last call" : "Connect to rejoin";
                            accent: root.is-connected;
                            enabled: root.is-connected;
                            horizontal-stretch: 1;
                            clicked => { root.join-room(root.join-code); }
                        }
                        HorizontalLayout {
                            alignment: space-between;
                            SectionLabel { text: "QUICK CALL"; }
                            VxButton {
                                label: root.show-quick-call ? "Hide" : "Show";
                                small: true;
                                ghost: true;
                                clicked => { root.show-quick-call = !root.show-quick-call; }
                            }
                        }

                        if root.show-quick-call : VerticalLayout {
                            spacing: 10px;
                            VxButton {
                                label: root.status-text == "Starting call..." ? "Starting..." :
                                       root.is-connected ? "Start Call" : "Connect first";
                                accent: true;
                                enabled: root.is-connected && root.status-text != "Starting call..." && root.status-text != "Joining call...";
                                horizontal-stretch: 1;
                                clicked => { root.create-room(); }
                            }
                            VxInput {
                                prominent: true;
                                text <=> root.join-code;
                                placeholder: "Room code";
                                accepted => {
                                    if root.is-connected && root.join-code != "" {
                                        root.join-room(root.join-code);
                                    }
                                }
                            }
                            VerticalLayout {
                                spacing: 8px;
                                VxInput {
                                    prominent: true;
                                    text <=> root.room-password;
                                    placeholder: "Password";
                                    input-type: InputType.password;
                                    horizontal-stretch: 1;
                                }
                                VxButton {
                                    label: "Join";
                                    soft: true;
                                    horizontal-stretch: 1;
                                    enabled: root.is-connected && root.join-code != "";
                                    clicked => { root.join-room(root.join-code); }
                                }
                            }
                        }
                    }
                }

                if root.spaces.length > 0 : VxCard {
                    VerticalLayout {
                        padding: 18px;
                        spacing: 12px;
                        SectionLabel { text: "SPACES"; }
                        for space in root.spaces : Rectangle {
                            height: 54px;
                            border-radius: VxTheme.radius-control;
                            background: space-compact-touch.has-hover ? VxTheme.row-hover-bg : VxTheme.bg-soft;
                            border-color: space.has-unread ? VxTheme.accent-border :
                                          space-compact-touch.has-hover ? VxTheme.border-subtle : VxTheme.border-subtle;
                            border-width: 1px;
                            clip: true;

                            space-compact-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.select-space(space.id); }
                            }

                            Rectangle {
                                x: 0px;
                                y: 8px;
                                width: 3px;
                                height: parent.height - 16px;
                                border-radius: 2px;
                                background: space.has-unread ? VxTheme.accent : transparent;
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;
                                alignment: center;

                                VxAvatar {
                                    avatar-size: 32px;
                                    initial: space.initial;
                                    color-index: space.color-index;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: space.name;
                                        color: VxTheme.text-primary;
                                        font-size: 13px;
                                        font-weight: 700;
                                    }
                                    Text {
                                        text: space.member-count + " members";
                                        color: VxTheme.text-muted;
                                        font-size: 11px;
                                    }
                                }
                                if space.has-unread : VxStatusPill {
                                    label: "New";
                                    tone: VxTheme.accent;
                                    fill: VxTheme.accent-subtle;
                                }
                            }
                        }
                    }
                }

                // ─── Explore Public Spaces ───
                VxCard {
                    VerticalLayout {
                        padding: 18px;
                        spacing: 12px;

                        HorizontalLayout {
                            alignment: space-between;
                            SectionLabel { text: "EXPLORE"; }
                            VxButton {
                                label: root.show-explore ? "Hide" : "Browse Servers";
                                small: true;
                                soft: true;
                                clicked => {
                                    root.show-explore = !root.show-explore;
                                    if root.show-explore {
                                        root.browse-public-spaces();
                                    }
                                }
                            }
                        }

                        if root.show-explore : VerticalLayout {
                            spacing: 8px;

                            if root.public-spaces.length == 0 : Text {
                                text: "No public spaces found. Ask a server admin to make their space public.";
                                color: VxTheme.text-muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }

                            for ps in root.public-spaces : Rectangle {
                                height: 62px;
                                border-radius: VxTheme.radius-control;
                                background: ps-touch.has-hover ? VxTheme.row-hover-bg : VxTheme.bg-soft;
                                border-color: ps.online-count > 0 ? VxTheme.success.transparentize(0.55) :
                                              ps-touch.has-hover ? VxTheme.border-subtle : VxTheme.border-subtle;
                                border-width: 1px;
                                clip: true;

                                ps-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.join-public-space(ps.invite-code); }
                                }

                                Rectangle {
                                    x: 0px;
                                    y: 8px;
                                    width: 3px;
                                    height: parent.height - 16px;
                                    border-radius: 2px;
                                    background: ps.online-count > 0 ? VxTheme.success : transparent;
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 10px;
                                    alignment: center;

                                    VxAvatar {
                                        avatar-size: 36px;
                                        initial: ps.initial;
                                        color-index: ps.color-index;
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text {
                                            text: ps.name;
                                            color: VxTheme.text-primary;
                                            font-size: 13px;
                                            font-weight: 700;
                                        }
                                        if ps.description != "" : Text {
                                            text: ps.description;
                                            color: VxTheme.text-secondary;
                                            font-size: 11px;
                                            overflow: elide;
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: ps.member-count + " members";
                                                color: VxTheme.text-muted;
                                                font-size: 11px;
                                            }
                                            if ps.online-count > 0 : HorizontalLayout {
                                                spacing: 3px;
                                                Rectangle {
                                                    width: 6px; height: 6px;
                                                    border-radius: 3px;
                                                    background: VxTheme.success;
                                                    y: 2px;
                                                }
                                                Text {
                                                    text: ps.online-count + " online";
                                                    color: VxTheme.success;
                                                    font-size: 11px;
                                                }
                                            }
                                        }
                                    }

                                    VxButton {
                                        label: "Join";
                                        small: true;
                                        accent: true;
                                        clicked => { root.join-public-space(ps.invite-code); }
                                    }
                                }
                            }
                        }
                    }
                }

                VxCard {
                    VerticalLayout {
                        padding: 18px;
                        spacing: 12px;

                        HorizontalLayout {
                            alignment: space-between;
                            SectionLabel { text: "DIRECT MESSAGES"; }
                            if root.unread-direct-messages-count > 0 : VxStatusPill {
                                label: root.unread-direct-messages-count + " unread";
                                tone: VxTheme.accent;
                                fill: VxTheme.accent-subtle;
                            }
                        }

                        if root.direct-message-threads.length == 0 : Text {
                            text: "Recent direct messages will appear here.";
                            color: VxTheme.text-muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }

                        for thread in root.direct-message-threads : Rectangle {
                            border-radius: VxTheme.radius-control;
                            background: dm-compact-touch.has-hover ? VxTheme.row-hover-bg : VxTheme.bg-soft;
                            border-color: thread.unread-count > 0 ? VxTheme.accent-border :
                                          dm-compact-touch.has-hover ? VxTheme.border-subtle : VxTheme.border-subtle;
                            border-width: 1px;
                            clip: true;

                            dm-compact-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open-direct-message(thread.user-id); }
                            }

                            Rectangle {
                                x: 0px;
                                y: 8px;
                                width: 3px;
                                height: parent.height - 16px;
                                border-radius: 2px;
                                background: thread.unread-count > 0 ? VxTheme.accent :
                                    thread.is-in-voice ? VxTheme.speaking-border : transparent;
                            }

                            VerticalLayout {
                                padding: 12px;
                                spacing: 6px;

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;

                                    VxAvatar {
                                        avatar-size: 28px;
                                        initial: thread.initial;
                                        color-index: thread.color-index;
                                        show-status: true;
                                        is-online: thread.is-online;
                                        is-speaking: thread.is-in-voice;
                                    }

                                    Text {
                                        text: thread.name;
                                        color: VxTheme.text-primary;
                                        font-size: 12px;
                                        font-weight: 700;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }

                                    Text {
                                        text: thread.meta;
                                        color: VxTheme.text-muted;
                                        font-size: 11px;
                                    }

                                    if thread.unread-count > 0 : VxStatusPill {
                                        label: thread.unread-count + "";
                                        tone: VxTheme.accent;
                                        fill: VxTheme.accent-subtle;
                                    }

                                    if dm-compact-touch.has-hover : Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border-radius: 4px;
                                        background: dm-call-compact.has-hover ? VxTheme.success.transparentize(0.8) : transparent;
                                        dm-call-compact := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.call-user(thread.user-id); }
                                        }
                                        Text {
                                            text: "Go";
                                            color: dm-call-compact.has-hover ? VxTheme.success : VxTheme.text-muted;
                                            font-size: 11px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    if dm-compact-touch.has-hover : Rectangle {
                                        width: 22px;
                                        height: 22px;
                                        border-radius: 4px;
                                        background: dm-close-compact.has-hover ? VxTheme.bg-elevated : transparent;
                                        dm-close-compact := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.close-direct-message(thread.user-id); }
                                        }
                                        Text {
                                            text: "\u{00D7}";
                                            color: dm-close-compact.has-hover ? VxTheme.text-primary : VxTheme.text-muted;
                                            font-size: 14px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                Text {
                                    text: thread.preview;
                                    color: VxTheme.text-secondary;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
