import { VxTheme } from "theme.slint";
import { VxIcons } from "icons.slint";

export component VxIcon inherits Image {
    in property <string> glyph: "";
    in property <image> icon-source;
    in property <brush> tone: VxTheme.accent;
    in property <length> icon-size: 16px;

    property <bool> has-explicit-icon: root.icon-source.width > 0 && root.icon-source.height > 0;
    property <bool> has-mapped-icon:
        root.glyph == "BK" || root.glyph == "HM" || root.glyph == "IO" || root.glyph == "SY" ||
        root.glyph == "GO" || root.glyph == "CL" || root.glyph == "PO" || root.glyph == "DM" ||
        root.glyph == "FR" || root.glyph == "RM" || root.glyph == "OK" || root.glyph == "NO" ||
        root.glyph == "CN" || root.glyph == "FV" || root.glyph == "VC" || root.glyph == "TX" ||
        root.glyph == "SV" || root.glyph == "TP" || root.glyph == "MG" || root.glyph == "DL" ||
        root.glyph == "ST" || root.glyph == "SH" || root.glyph == "MD" || root.glyph == "DN" ||
        root.glyph == "AD" || root.glyph == "AU" || root.glyph == "MU" || root.glyph == "TM" ||
        root.glyph == "KK" || root.glyph == "BN" || root.glyph == "LV" || root.glyph == "RN" ||
        root.glyph == "PB" || root.glyph == "PR" || root.glyph == "SR" || root.glyph == "RP" ||
        root.glyph == "TH" || root.glyph == "FW" || root.glyph == "PN" || root.glyph == "UP" ||
        root.glyph == "ED" || root.glyph == "FI" || root.glyph == "LN" || root.glyph == "AT" ||
        root.glyph == "EM" || root.glyph == "MX" || root.glyph == "CP" || root.glyph == "SD";
    out property <bool> available: root.has-explicit-icon || root.has-mapped-icon;

    width: root.icon-size;
    height: root.icon-size;
    source: root.has-explicit-icon ? root.icon-source :
        root.glyph == "BK" ? VxIcons.back :
        root.glyph == "HM" ? VxIcons.home :
        root.glyph == "IO" ? VxIcons.settings :
        root.glyph == "SY" ? VxIcons.system :
        root.glyph == "GO" ? VxIcons.play :
        root.glyph == "CL" || root.glyph == "NO" || root.glyph == "CN" ? VxIcons.close :
        root.glyph == "PO" ? VxIcons.popout :
        root.glyph == "DM" ? VxIcons.dm :
        root.glyph == "FR" ? VxIcons.user-plus :
        root.glyph == "RM" || root.glyph == "DN" ? VxIcons.user-minus :
        root.glyph == "OK" || root.glyph == "SV" || root.glyph == "ST" ? VxIcons.check :
        root.glyph == "FV" ? VxIcons.star :
        root.glyph == "VC" || root.glyph == "AU" ? VxIcons.voice :
        root.glyph == "TX" || root.glyph == "TP" ? VxIcons.text :
        root.glyph == "MG" ? VxIcons.settings :
        root.glyph == "DL" ? VxIcons.trash :
        root.glyph == "SH" ? VxIcons.share :
        root.glyph == "MD" || root.glyph == "AD" ? VxIcons.shield :
        root.glyph == "MU" ? VxIcons.mic-off :
        root.glyph == "TM" ? VxIcons.clock :
        root.glyph == "KK" || root.glyph == "LV" ? VxIcons.exit :
        root.glyph == "BN" ? VxIcons.ban :
        root.glyph == "RN" || root.glyph == "ED" ? VxIcons.edit :
        root.glyph == "PB" ? VxIcons.globe :
        root.glyph == "PR" ? VxIcons.lock :
        root.glyph == "SR" ? VxIcons.search :
        root.glyph == "RP" ? VxIcons.reply :
        root.glyph == "TH" ? VxIcons.thread :
        root.glyph == "FW" ? VxIcons.forward :
        root.glyph == "PN" ? VxIcons.pin :
        root.glyph == "UP" ? VxIcons.pin-off :
        root.glyph == "FI" ? VxIcons.file :
        root.glyph == "LN" ? VxIcons.link :
        root.glyph == "AT" ? VxIcons.mention :
        root.glyph == "EM" ? VxIcons.emoji :
        root.glyph == "MX" ? VxIcons.levels :
        root.glyph == "CP" ? VxIcons.copy :
        root.glyph == "SD" ? VxIcons.send :
        VxIcons.home;
    colorize: root.tone;
    image-fit: contain;
    visible: root.available;
}

export component VxButton inherits Rectangle {
    in property <string> label: "";
    in property <string> glyph: "";
    in property <image> icon-source;
    in property <bool> accent: false;
    in property <bool> danger: false;
    in property <bool> small: false;
    in property <bool> enabled: true;
    in property <bool> ghost: false;
    in property <bool> soft: false;
    callback clicked();

    // One button language: filled (accent/danger), outline (default),
    // tonal (soft), and text-only (ghost). No icon plates, no edge sheens.
    property <color> fg: !root.enabled ? VxTheme.text-muted :
        root.accent || root.danger ? #ffffff :
        root.ghost ? (touch.has-hover ? VxTheme.text-primary : VxTheme.text-secondary) :
        VxTheme.text-primary;

    height: (root.small ? 30px : 36px) * VxTheme.s;
    min-width: (root.small ? 56px : 80px) * VxTheme.s;
    // Buttons hug their content; call sites opt in to stretching explicitly.
    horizontal-stretch: 0;
    border-radius: VxTheme.radius-control;
    clip: true;
    background: !root.enabled ? (root.ghost ? transparent : VxTheme.bg-raised) :
                touch.pressed ? (root.danger ? VxTheme.danger-pressed :
                                root.accent ? VxTheme.accent-pressed :
                                root.soft ? VxTheme.surface-active : VxTheme.btn-hover-bg) :
                touch.has-hover ? (root.danger ? VxTheme.danger-hover :
                                  root.accent ? VxTheme.accent-hover :
                                  root.soft ? VxTheme.btn-hover-bg : VxTheme.btn-hover-bg) :
                root.danger ? VxTheme.danger :
                root.accent ? VxTheme.accent :
                root.soft ? VxTheme.bg-soft : transparent;
    border-color: root.accent || root.danger || root.soft || !root.enabled ? transparent :
                  root.ghost ? transparent : VxTheme.border-strong;
    border-width: 1px;

    animate background { duration: VxTheme.dur-fast; easing: ease-out; }
    animate border-color { duration: VxTheme.dur-fast; easing: ease-out; }

    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if root.enabled { root.clicked(); }
        }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 6px;
        padding-left: root.small ? 10px : 14px;
        padding-right: root.small ? 10px : 14px;

        if root.glyph != "" || (root.icon-source.width > 0 && root.icon-source.height > 0) : Rectangle {
            width: root.small ? 14px : 16px;

            icon-preview := VxIcon {
                x: (parent.width - self.width) * 0.5;
                y: (parent.height - self.height) * 0.5;
                glyph: root.glyph;
                icon-source: root.icon-source;
                icon-size: root.small ? 13px : 15px;
                tone: root.fg;
            }

            if !icon-preview.available && root.glyph != "" : Text {
                text: root.glyph;
                color: root.fg;
                font-size: (root.small ? 9px : 10px) * VxTheme.s;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.label;
            color: root.fg;
            font-size: (root.small ? VxTheme.font-caption : VxTheme.font-body) * VxTheme.s;
            font-weight: VxTheme.weight-semibold;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component VxCard inherits Rectangle {
    // Flat surface: one tonal step above the panel, one hairline. Depth is
    // tonal, never decorative.
    background: VxTheme.bg-card;
    border-radius: VxTheme.radius-card;
    border-color: VxTheme.border-subtle;
    border-width: 1px;
    clip: true;
}

export component VxInput inherits Rectangle {
    // Custom-drawn field on the raw TextInput primitive: the std LineEdit
    // paints its own platform-style chrome, which fought the theme and
    // clipped descenders at some DPI/font combinations.
    in-out property <string> text <=> inner.text;
    in property <string> placeholder: "";
    in property <InputType> input-type <=> inner.input-type;
    in property <bool> enabled: true;
    in property <bool> prominent: false;
    callback accepted();
    forward-focus: inner;

    height: (root.prominent ? 44px : 36px) * VxTheme.s;
    border-radius: VxTheme.radius-control;
    background: VxTheme.bg-input;
    border-color: inner.has-focus ? VxTheme.accent : VxTheme.border-subtle;
    border-width: 1px;
    clip: true;
    opacity: root.enabled ? 1.0 : 0.5;

    animate border-color { duration: 100ms; easing: ease-out; }

    // Focus ring: a soft inner outline in the accent, no width jump.
    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-radius: parent.border-radius - 1px;
        background: transparent;
        border-color: VxTheme.accent-glow;
        border-width: inner.has-focus ? 2px : 0px;
    }

    // Click anywhere in the field (padding included) to focus.
    TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.text : MouseCursor.default;
        clicked => {
            if root.enabled { inner.focus(); }
        }
    }

    HorizontalLayout {
        padding-left: 12px * VxTheme.s;
        padding-right: 12px * VxTheme.s;

        inner := TextInput {
            vertical-alignment: center;
            single-line: true;
            wrap: no-wrap;
            enabled: root.enabled;
            font-size: (root.prominent ? 14px : 13px) * VxTheme.s;
            color: VxTheme.text-primary;
            selection-background-color: VxTheme.accent.transparentize(0.72);
            selection-foreground-color: VxTheme.text-primary;
            accepted => { root.accepted(); }
        }
    }

    if root.text == "" : Text {
        x: 13px * VxTheme.s;
        width: parent.width - 26px * VxTheme.s;
        height: parent.height;
        text: root.placeholder;
        color: VxTheme.text-muted;
        font-size: (root.prominent ? 14px : 13px) * VxTheme.s;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component SectionLabel inherits Text {
    // Quiet overline: muted, small, lightly tracked.
    color: VxTheme.text-muted;
    font-size: 11px * VxTheme.s;
    font-weight: 600;
    letter-spacing: 0.8px;
    overflow: elide;
}

export component FieldLabel inherits Text {
    color: VxTheme.text-secondary;
    font-size: 11px;
    font-weight: 600;
}

export component KeyPill inherits Rectangle {
    in property <string> key-text: "";

    min-width: 30px;
    height: 24px;
    border-radius: 8px;
    background: VxTheme.bg-raised;
    border-color: VxTheme.border-subtle;
    border-width: 1px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.key-text;
            color: VxTheme.text-primary;
            font-size: 10px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component StatusDot inherits Rectangle {
    in property <bool> active: false;

    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: root.active ? VxTheme.success : VxTheme.text-muted;

    animate background { duration: 160ms; }
}

export component AccentBar inherits Rectangle {
    // Single quiet hairline — the multi-hue gradient bar read as a stray
    // line through nearby text.
    height: 1px;
    background: VxTheme.border-subtle;
}

export component VxStatusPill inherits Rectangle {
    in property <string> label: "";
    /// Semantic kind: "warning", "danger", "success", or default (accent).
    in property <string> kind: "";
    in property <color> tone: kind == "warning" ? VxTheme.warning :
                               kind == "danger"  ? VxTheme.danger  :
                               kind == "success" ? VxTheme.success : VxTheme.accent;
    in property <color> fill: root.tone.transparentize(0.88);

    height: 22px;
    // A pill never stretches — stretched pill borders read as stray lines.
    horizontal-stretch: 0;
    border-radius: 6px;
    background: root.fill;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.label;
            color: root.tone;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component VxStatBlock inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    in property <string> detail: "";
    in property <color> tone: VxTheme.accent;

    border-radius: VxTheme.radius-card;
    background: VxTheme.bg-soft;
    border-color: VxTheme.border-subtle;
    border-width: 1px;

    VerticalLayout {
        padding: 12px * VxTheme.s;
        spacing: 2px;
        Text {
            text: root.label;
            color: VxTheme.text-muted;
            font-size: 10px * VxTheme.s;
            font-weight: VxTheme.heading-weight;
            letter-spacing: VxTheme.section-spacing;
        }
        Text {
            text: root.value;
            color: root.tone;
            font-size: 17px * VxTheme.s;
            font-weight: VxTheme.heading-weight;
            wrap: word-wrap;
        }
        if root.detail != "" : Text {
            text: root.detail;
            color: VxTheme.text-secondary;
            font-size: 10px * VxTheme.s;
            wrap: word-wrap;
        }
    }
}

export component VxGlyphTile inherits Rectangle {
    in property <string> glyph: "";
    in property <image> icon-source;
    in property <color> tone: VxTheme.accent;
    in property <length> tile-size: 30px;

    width: root.tile-size;
    height: root.tile-size;
    border-radius: root.tile-size * 0.28;
    background: root.tone.transparentize(0.90);
    clip: true;

    tile-icon := VxIcon {
        x: (parent.width - self.width) * 0.5;
        y: (parent.height - self.height) * 0.5;
        glyph: root.glyph;
        icon-source: root.icon-source;
        icon-size: root.tile-size * 0.46;
        tone: root.tone;
    }

    if !tile-icon.available : Text {
        text: root.glyph;
        color: root.tone;
        font-size: root.tile-size * 0.32;
        font-weight: 800;
        letter-spacing: 0.7px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component VxActionTile inherits Rectangle {
    in property <string> eyebrow: "";
    in property <string> title: "";
    in property <string> detail: "";
    in property <bool> active: false;
    in property <color> tone: VxTheme.accent;
    callback clicked();

    border-radius: VxTheme.radius-card;
    background: root.active ? root.tone.transparentize(0.86) : VxTheme.bg-soft;
    border-color: root.active ? root.tone.transparentize(0.40) : VxTheme.border-subtle;
    border-width: 1px;
    clip: true;

    animate background { duration: 90ms; easing: ease-out; }
    animate border-color { duration: 90ms; easing: ease-out; }

    Rectangle {
        width: parent.width;
        height: 2px;
        background: root.active ? root.tone : VxTheme.accent-subtle;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        padding: 16px;
        spacing: 5px;
        Text {
            text: root.eyebrow;
            color: VxTheme.text-muted;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.8px;
        }
        Text {
            text: root.title;
            color: root.active ? root.tone : VxTheme.text-primary;
            font-size: 17px;
            font-weight: 700;
            wrap: word-wrap;
        }
        Text {
            text: root.detail;
            color: VxTheme.text-secondary;
            font-size: 10px;
            wrap: word-wrap;
        }
    }
}

export component VxOptionRow inherits Rectangle {
    in property <string> label: "";
    in property <string> detail: "";
    in property <bool> selected: false;
    callback clicked();

    border-radius: VxTheme.radius-control;
    background: root.selected ? VxTheme.tab-active-bg :
                touch.has-hover ? VxTheme.card-hover-bg : VxTheme.bg-soft;
    border-color: root.selected ? VxTheme.accent-border : VxTheme.border-subtle;
    border-width: 1px;
    clip: true;

    animate background { duration: 80ms; easing: ease-out; }
    animate border-color { duration: 80ms; easing: ease-out; }

    Rectangle {
        width: parent.width;
        height: 1px;
        background: root.selected ? VxTheme.accent-subtle : #ffffff08;
        opacity: 0.75;
    }

    Rectangle {
        x: 0px;
        y: 6px;
        width: 3px;
        height: parent.height - 12px;
        border-radius: 2px;
        background: root.selected ? VxTheme.accent : transparent;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 8px;
        alignment: center;

        Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: root.selected ? VxTheme.accent : VxTheme.bg-panel;
            border-color: root.selected ? VxTheme.accent : VxTheme.border-strong;
            border-width: 2px;
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.label;
                color: VxTheme.text-primary;
                font-size: 11px;
                font-weight: 700;
                overflow: elide;
            }
            if root.detail != "" : Text {
                text: root.detail;
                color: VxTheme.text-muted;
                font-size: 9px;
                overflow: elide;
            }
        }

        if root.selected : VxStatusPill {
            label: "Active";
            tone: VxTheme.accent;
            fill: VxTheme.accent-subtle;
        }
    }
}

export component MetricRow inherits Rectangle {
    in property <string> metric-label: "";
    in property <string> metric-value: "";
    in property <color> indicator-color: VxTheme.success;

    height: 34px;
    background: VxTheme.bg-soft;
    border-radius: VxTheme.radius-control;
    border-color: VxTheme.border-subtle;
    border-width: 1px;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 8px;
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.indicator-color;
            }
            Text {
                text: root.metric-label;
                color: VxTheme.text-secondary;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.metric-value;
            color: VxTheme.text-primary;
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

export component VxSlider inherits Rectangle {
    in-out property <float> value: 1.0;
    callback changed(float);

    height: 28px;
    min-width: 80px;
    background: transparent;

    // Track background
    Rectangle {
        x: 0px;
        y: (parent.height - 8px) / 2;
        width: parent.width;
        height: 8px;
        border-radius: 4px;
        background: VxTheme.border-subtle;

        // Filled portion
        Rectangle {
            width: parent.width * root.value;
            height: parent.height;
            border-radius: 4px;
            background: VxTheme.accent;
            animate width { duration: 50ms; easing: ease-out; }
        }
    }

    // Handle
    Rectangle {
        x: (parent.width - 22px) * root.value;
        y: (parent.height - 22px) / 2;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: touch.pressed ? VxTheme.text-primary :
                    touch.has-hover ? VxTheme.accent : VxTheme.bg-panel;
        border-color: touch.pressed ? VxTheme.text-primary : VxTheme.accent;
        border-width: 2.5px;
        drop-shadow-blur: touch.has-hover ? 4px : 0px;
        drop-shadow-color: VxTheme.accent.transparentize(0.7);

        animate background { duration: 80ms; easing: ease-out; }
        animate border-color { duration: 80ms; easing: ease-out; }
        animate drop-shadow-blur { duration: 120ms; }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        moved => {
            if self.pressed {
                root.value = clamp(self.mouse-x / root.width, 0.0, 1.0);
                root.changed(root.value);
            }
        }
        clicked => {
            root.value = clamp(self.mouse-x / root.width, 0.0, 1.0);
            root.changed(root.value);
        }
    }
}

export component Divider inherits Rectangle {
    /// Default 1px subtle divider. For major zone boundaries set `strong: true`
    /// for a thicker, more saturated line.
    in property <bool> strong: false;
    height: root.strong ? 2px : 1px;
    background: root.strong ? VxTheme.border-strong : VxTheme.border-subtle;
}

export component VxLogo inherits Rectangle {
    // One brand mark for every preset: accent tile, three white wave bars.
    in property <length> logo-size: 28px;

    width: root.logo-size;
    height: root.logo-size;
    border-radius: root.logo-size * 0.26;
    background: VxTheme.accent;
    clip: true;

    property <length> band-w: root.logo-size * 0.12;
    property <length> band-gap: root.logo-size * 0.09;
    property <length> band-start-x: (root.logo-size - (band-w * 3 + band-gap * 2)) / 2;

    Rectangle {
        x: root.band-start-x;
        y: root.logo-size * 0.36;
        width: root.band-w;
        height: root.logo-size * 0.28;
        border-radius: root.band-w / 2;
        background: #ffffffd8;
    }
    Rectangle {
        x: root.band-start-x + root.band-w + root.band-gap;
        y: root.logo-size * 0.22;
        width: root.band-w;
        height: root.logo-size * 0.56;
        border-radius: root.band-w / 2;
        background: #ffffff;
    }
    Rectangle {
        x: root.band-start-x + (root.band-w + root.band-gap) * 2;
        y: root.logo-size * 0.30;
        width: root.band-w;
        height: root.logo-size * 0.40;
        border-radius: root.band-w / 2;
        background: #ffffffd8;
    }
}

export component VxLogoBig inherits Rectangle {
    width: 72px;
    height: 72px;

    VxLogo {
        logo-size: 72px;
    }
}

export component VxAvatar inherits Rectangle {
    in property <string> initial: "";
    in property <int> color-index: 0;
    in property <length> avatar-size: 36px;
    in property <bool> is-speaking: false;
    in property <bool> show-status: false;
    in property <bool> is-online: false;
    in property <int> status-level: 0;  // 0=offline, 1=online, 2=idle, 3=dnd

    width: root.avatar-size;
    height: root.avatar-size;
    border-radius: root.avatar-size * VxTheme.avatar-roundness;
    background: VxTheme.avatar-color(root.color-index);
    border-color: root.is-speaking ? VxTheme.speaking-border : VxTheme.bg-panel;
    border-width: root.is-speaking ? (VxTheme.btn-border-width + 2px) : 1px;
    clip: true;

    animate border-color { duration: 180ms; }
    animate border-width { duration: 180ms; }

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: parent.border-radius;
        background: @linear-gradient(160deg, #ffffff1c 0%, transparent 55%, #00101a20 100%);
    }

    Text {
        text: root.initial;
        color: VxTheme.text-inverse;
        font-size: root.avatar-size * 0.38;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.show-status : Rectangle {
        x: parent.width - self.width - 1px;
        y: parent.height - self.height - 1px;
        width: root.avatar-size * 0.32;
        height: self.width;
        border-radius: self.width / 2;
        background: root.status-level == 3 ? VxTheme.danger :
                    root.status-level == 2 ? VxTheme.warning :
                    root.status-level == 1 ? VxTheme.success :
                    root.is-online ? VxTheme.success : VxTheme.text-muted;
        border-color: VxTheme.bg-panel;
        border-width: 2px;
    }
}

export component VxToggle inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled();

    width: 42px;
    height: 24px;
    border-radius: 12px;
    background: root.checked ? VxTheme.accent : VxTheme.bg-raised;
    border-color: root.checked ? VxTheme.accent-border : VxTheme.border-subtle;
    border-width: 1px;

    animate background { duration: 120ms; easing: ease-out; }
    animate border-color { duration: 120ms; easing: ease-out; }

    toggle-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }

    Rectangle {
        x: root.checked ? parent.width - self.width - 3px : 3px;
        y: 3px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: #f7fcff;
        animate x { duration: 120ms; easing: ease-out; }
    }
}
